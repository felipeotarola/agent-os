[Unit]
Description=Validate OpenClaw backup readiness and freshness
After=docker.service user@0.service network-online.target openclaw-backup-gpg-agent.service
Wants=docker.service user@0.service network-online.target
Requires=openclaw-backup-gpg-agent.service
OnFailure=openclaw-backup-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/openclaw-backup/current/openclaw-backup-healthcheck.sh
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
UMask=0077
RuntimeDirectory=openclaw-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/openclaw-backup
ReadWritePaths=/etc/openclaw-backup/gnupg
ReadWritePaths=/run/openclaw-backup
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
