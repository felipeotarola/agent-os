[Unit]
Description=Create and upload a quiesced OpenClaw backup
Wants=docker.service user@0.service network-online.target
After=docker.service user@0.service network-online.target
Conflicts=shutdown.target
OnFailure=openclaw-backup-maintenance-guard.service openclaw-backup-alert@%n.service
StartLimitIntervalSec=10min
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/openclaw-backup/current/openclaw-backup-maintenance.sh run
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
UMask=0077
RuntimeDirectory=openclaw-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=6h
TimeoutStopSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=3G
MemoryMax=3500M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
TemporaryFileSystem=/run/openclaw-backup-tmp:rw,nosuid,nodev,noexec,noswap,size=1536M,mode=0700
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.openclaw
ReadWritePaths=/root/.cache/openclaw
ReadWritePaths=/var/lib/openclaw-backup
ReadWritePaths=/etc/openclaw-backup/gnupg
ReadWritePaths=/run/openclaw-backup
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
