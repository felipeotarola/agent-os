[Unit]
Description=Recover services after an interrupted OpenClaw backup
ConditionPathExists=/var/lib/openclaw-backup/state/maintenance-active.json
Wants=docker.service user@0.service network-online.target
After=docker.service user@0.service network-online.target
Before=openclaw-backup-maintenance.service
OnFailure=openclaw-backup-alert@%n.service
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/openclaw-backup/current/openclaw-backup-maintenance.sh --recover-only
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
UMask=0077
RuntimeDirectory=openclaw-backup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=20min
TimeoutStopSec=20min
Restart=on-failure
RestartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.openclaw
ReadWritePaths=/root/.cache/openclaw
ReadWritePaths=/var/lib/openclaw-backup
ReadWritePaths=/etc/openclaw-backup/gnupg
ReadWritePaths=/run/openclaw-backup
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
