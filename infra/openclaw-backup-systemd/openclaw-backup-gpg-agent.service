[Unit]
Description=Persistent GPG agent for OpenClaw backup signing
Before=openclaw-backup-healthcheck.service openclaw-backup-maintenance.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=GNUPGHOME=/etc/openclaw-backup/gnupg
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
Environment=OPENCLAW_BACKUP_GPG_SIGNER=A21CDBA4C148498DD96AE3B25BD3DABE32ED63DD
ExecStart=/usr/bin/gpgconf --homedir /etc/openclaw-backup/gnupg --launch gpg-agent
ExecStartPost=/bin/sh -c 'exec /usr/bin/gpg --homedir "$GNUPGHOME" --batch --no-autostart --with-colons --list-secret-keys "$OPENCLAW_BACKUP_GPG_SIGNER" >/dev/null'
ExecStop=/usr/bin/gpgconf --homedir /etc/openclaw-backup/gnupg --kill gpg-agent
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/openclaw-backup/gnupg
ReadWritePaths=/run/user/0/gnupg
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
