{
  "name": "agent-os-vault",
  "version": "2.0.0",
  "private": true,
  "description": "A private, file-backed credential vault for local agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:credentials": "node scripts/credentials-contract.mjs",
    "verify": "npm run check:credentials && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.13 <25"
  }
}
